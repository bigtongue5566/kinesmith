{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinesmith.local/schemas/project-1",
  "title": "Kinesmith editable motion project v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "title", "revision", "fps", "width", "height", "duration_frames", "scenes"],
  "properties": {
    "schema_version": {"const": "1.0"}, "id": {"type": "string", "minLength": 1},
    "title": {"type": "string"}, "revision": {"type": "integer", "minimum": 1},
    "fps": {"type": "string", "pattern": "^[0-9]+(?:/[0-9]+)?$"},
    "width": {"type": "integer", "minimum": 16}, "height": {"type": "integer", "minimum": 16},
    "duration_frames": {"type": "integer", "minimum": 1}, "seed": {"type": "integer"},
    "prompt": {"type": "string"}, "brief": {"type": "string"},
    "features": {"type": "string"}, "interchange": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "licenses": {"type": "array", "items": {"type": "object"}},
    "revisions": {"type": "array", "items": {"type": "object"}},
    "audio": {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {
      "source": {"type": "string"}, "offset_seconds": {"type": "number"}, "gain": {"type": "number", "minimum": 0}
    }},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "engine", "source", "start_frame", "duration_frames"], "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "engine": {"enum": ["canvas", "rough", "p5", "three", "manim", "blender", "video", "image"]},
        "source": {"type": "string"}, "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1}, "source_start_frame": {"type": "integer", "minimum": 0},
        "layer": {"type": "integer"}, "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "params": {"type": "object"}, "class_name": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "transition_in": {"$ref": "#/$defs/transition"}, "transition_out": {"$ref": "#/$defs/transition"}
      }
    }}
  },
  "$defs": {"transition": {"type": "object", "additionalProperties": false, "required": ["type", "duration_frames"],
    "properties": {"type": {"enum": ["fade", "wipe-left", "wipe-right"]}, "duration_frames": {"type": "integer", "minimum": 1}}}}
}
