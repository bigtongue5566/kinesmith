<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Opusmith.OpenUtau</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenUtau.Core"><HintPath>$(OpenUtauDir)/OpenUtau.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NAudio.Core"><HintPath>$(OpenUtauDir)/NAudio.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Serilog"><HintPath>$(OpenUtauDir)/Serilog.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Nito.AsyncEx.Context" Version="5.1.2" />
  </ItemGroup>
</Project>
